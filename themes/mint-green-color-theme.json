{
  "$schema": "vscode://schemas/color-theme",
  "name": "Mint Green",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#CCE8CF",
    "editor.foreground": "#1E1E1E",
    "editor.findMatchBackground": "#fbff0071",
    "editor.findMatchHighlightBackground": "#00bfff69",
    "editor.findRangeHighlightBackground": "#ff99006e",
    "editor.selectionBackground": "#4A90E280",
    "editor.selectionHighlightBackground": "#4A90E230",
    "editor.lineHighlightBackground": "#00000012",
    "editor.wordHighlightBackground": "#B0D4FF80",
    "editor.wordHighlightStrongBackground": "#FFD70080",
    "editorBracketMatch.background": "#B8E0C870",
    "editorBracketMatch.border": "#5A9A5A",
    "editorGutter.background": "#CCE8CF",
    "editorLineNumber.foreground": "#1A6E7E",
    "editorWidget.background": "#E0F0E0",
    "breadcrumb.background": "#CCE8CF",
    "editorGroupHeader.tabsBackground": "#c1d3c1",
    "tab.activeBackground": "#CCE8CF",
    "tab.inactiveBackground": "#b1cab1",
    "tab.activeBorder": "#5A9A5A",
    "tab.hoverBackground": "#BEE0BE",
    "sideBar.background": "#BCD8BF",
    "sideBar.foreground": "#1A3A1A",
    "sideBarSectionHeader.background": "#A8C8AB",
    "sideBarSectionHeader.foreground": "#1A3A1A",
    "activityBar.background": "#A8C8AB",
    "activityBar.foreground": "#1A3A1A",
    "activityBar.inactiveForeground": "#3A6A3A",
    "activityBarBadge.background": "#2E7D32",
    "titleBar.activeBackground": "#A8C8AB",
    "titleBar.activeForeground": "#1A3A1A",
    "titleBar.inactiveBackground": "#B8D4BB",
    "statusBar.background": "#3F7F43",
    "statusBar.foreground": "#F0FFF0",
    "statusBar.debuggingBackground": "#A65A1E",
    "statusBar.noFolderBackground": "#4F6E7E",
    "panel.background": "#D0F0D0",
    "terminal.background": "#D0F0D0",
    "input.background": "#E8F5E9",
    "input.border": "#A8C8AB",
    "dropdown.background": "#E8F5E9",
    "focusBorder": "#5A9A5A",
    "button.background": "#3D7A41",
    "badge.background": "#2E7D32",
    "notifications.background": "#E0F0E0",
    "list.hoverBackground": "#B8DDB8",
    "list.activeSelectionBackground": "#A0CCA0",
    "list.inactiveSelectionBackground": "#AACFAA",
    "scrollbarSlider.background": "#A8C8AB80",
    "scrollbarSlider.hoverBackground": "#7AAD7EAA",
    "editorCursor.foreground": "#2E7D32",
    "editorIndentGuide.background1": "#B0D0B080",
    "editorRuler.foreground": "#A0C0A060",
    "editorWhitespace.foreground": "#B0D0B0",
    "tab.unfocusedActiveBackground": "#C0DCC0",
    "gitDecoration.modifiedResourceForeground": "#7A5A00",
    "gitDecoration.untrackedResourceForeground": "#0F6B3C",
    "gitDecoration.deletedResourceForeground": "#8E3F1F"
  },
  "semanticTokenColors": {
    "comment": "#62766A",
    "string": "#A84800",
    "keyword": "#4527A0",
    "number": "#B0006B",
    "function": "#0060B8",
    "method": "#0060B8",
    "type": "#8A2BA8",
    "class": "#8A2BA8",
    "interface": "#8A2BA8",
    "struct": "#8A2BA8",
    "enum": "#8A2BA8",
    "typeParameter": "#8A2BA8",
    "variable": "#00695C",
    "property": "#00695C",
    "parameter": "#6B4F1D",
    "namespace": "#5F6A00",
    "enumMember": "#B0006B",
    "macro": "#B0006B"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#62766A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.constant.go"
      ],
      "settings": {
        "foreground": "#B0006B"
      }
    },
    {
      "scope": [
        "variable.other.go"
      ],
      "settings": {
        "foreground": "#00695C"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#A84800"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#4527A0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B0006B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0060B8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.interface",
        "storage.type"
      ],
      "settings": {
        "foreground": "#8A2BA8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#00695C"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6B4F1D"
      }
    }
  ]
}
